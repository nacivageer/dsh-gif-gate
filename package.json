{
  "name": "dsh-gif-gate",
  "version": "0.1.0-alpha.2",
  "license": "MIT",
  "author": "72NG",
  "description": "Host-only gate that blocks the first animated-image read in a session until the model has read a strategy document — enforcement at the tool entry, not in a skill description. · 看动图前先读策略，没读就拦一次。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "strategy-template.md",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "gif",
    "animated-webp",
    "vision",
    "strategy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacivageer/dsh-gif-gate.git"
  },
  "homepage": "https://github.com/nacivageer/dsh-gif-gate#readme",
  "bugs": {
    "url": "https://github.com/nacivageer/dsh-gif-gate/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/gate.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
